<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3c09cc44-8adb-4f2e-aa9f-d4eca1ff5e7b</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment) is a warning-per-undocumented-public-member; we document
         controllers/actions deliberately but don't want it to fail the build for incidental
         public members (DTOs, internal helper types marked public for DI, etc). -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Algorand4" Version="4.7.4.2026080422" />
    <PackageReference Include="AlgorandAuthentication" Version="2.2.0" />
    <PackageReference Include="Elastic.Clients.Elasticsearch" Version="9.5.3" />
    <!-- transitive (AlgorandAuthentication): pinned to the release that fixes GHSA-vrrp-6v32-2p8g - remove once AlgorandAuthentication references it -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.15" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.3.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.35" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.Filters" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="doc\description.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AVMTradeReporter.Models\AVMTradeReporter.Models.csproj" />
  </ItemGroup>

</Project>
